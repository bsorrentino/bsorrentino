package "purchase-assistant" {
circle start<<input>> as __START__
circle stop as __END__
usecase "model"<<Node>>
usecase "action_dispatcher"<<Node>>
}

package agent-payment {
circle " " as agent_payment___START__
circle exit as agent_payment___END__
usecase "model"<<Node>> as agent_payment_model
usecase "action_dispatcher"<<Node>> as agent_payment_action_dispatcher
usecase "submit-payment"<<Node>> as agent_payment_submit_payment
